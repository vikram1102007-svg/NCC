# MongoDB Atlas Free Tier Connection String (never commit real credentials)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/ncc_kpriet?retryWrites=true&w=majority

# Long random secret (at least 32 characters) used to sign httpOnly session cookies
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# Used ONLY by `npm run seed` to create the initial Admin user
ADMIN_EMAIL=officer@kpriet.ac.in
ADMIN_PASSWORD=ReplaceWithStrongAdminPassword123!

# Optional: cookie security override for local HTTP testing (leave unset on Vercel)
# NODE_ENV=production
# CORS_ORIGIN=https://your-site.vercel.app
